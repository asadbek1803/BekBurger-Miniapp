# ── Django ──
# Production uchun ALBATTAGA o'zgartiring!
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# Kamida 50 belgi. DEBUG=False bo'lganda bu sozlamalar tekshiriladi:
#   • DJANGO_SECRET_KEY — standart yoki qisqa bo'lsa ilova ishga tushmaydi
#   • DEV_MODE          — True bo'lsa ilova ishga tushmaydi
#   • ALLOWED_HOSTS     — "*" bo'lsa ilova ishga tushmaydi
DJANGO_SECRET_KEY=django-insecure-bekburger-secret-key-change-in-production-2024
DEBUG=True

# Telegram initData tekshiruvi. Production uchun MUTLAQA False
DEV_MODE=True

# Restoran nomi (bo'sh bo'lsa BekBurger qoladi)
RESTAURANT_NAME=BekBurger

# Debug=True bo'lsa '*' ishlatiladi. Production uchun aniq yozing:
# ALLOWED_HOSTS=bekburger.uz,www.bekburger.uz

# CSRF va frame-ancestors. Production uchun o'z domeningizni qo'shing:
# CSRF_TRUSTED_ORIGINS=https://bekburger.uz
# CSP_FRAME_ANCESTORS=https://web.telegram.org,https://*.telegram.org

# ── Telegram ──
TELEGRAM_BOT_TOKEN=
# Ichki xabarlar uchun (ixtiyoriy)
TELEGRAM_BOT_CHAT_ID=

# ── Ma'lumotlar bazasi ──
# sqlite (sukutcha) yoki postgres
DB_ENGINE=sqlite
POSTGRES_DB=bekburger
POSTGRES_USER=bekburger
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ── Channels (real-time) ──
# Redis yo'q bo'lsa InMemory ishlaydi (faqat bitta process).
# Ko'p ishchi (workers=2+) ishlatayotgan bo'lsangiz Redis SHART.
REDIS_URL=

# ── Xarita: plitkalar (tiles) ─────────────────────────────────────────────
# tile.openstreetmap.org ISHLATILMAYDI — OSM serverlari ko'ngillilar
# hisobiga ishlaydi va Tile Usage Policy buzilsa IP bloklanadi.
# Standart provayder — CARTO (Voyager). URL Leaflet placeholder'larini
# ({z}/{x}/{y}, {s}, {r}) qo'llaydi.
MAP_TILE_URL=https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png?key=cb1_47sc_1_3b214a8c6cb5a56646f2cf46
MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>
MAP_MAX_ZOOM=19

# ── Xarita: reverse geokodlash (kordinata -> manzil) ──────────────────────
# O'z serverimizdagi Nominatim. Bo'sh bo'lsa endpoint 503 qaytaradi va
# frontend "Lat: ..., Lng: ..." ko'rsatadi (xarita ishlashda davom etadi).
#   docker run -d -p 8080:8080 -e NOMINATIM_DB=... nominatim/openstreetmap-nominatim
# Ichki tarmoqda ishlatish tavsiya qilinadi (localhost bo'lsa ham 503 beriladi
# — bu qasddan, localhost'ni ham tekshirish uchun emas, savdo tarmog'iga
# chiqmasligi uchun).
GEOCODER_URL=
GEOCODER_MAX_ZOOM=18

# ── Boshqa ──
TIME_ZONE=Asia/Tashkent
LOG_LEVEL=INFO
IMAGE_MAX_SIZE_MB=5
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
